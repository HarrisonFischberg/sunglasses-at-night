{
  "manifest_version": 3,
  "name": "Sunglasses for Safari",
  "description": "Dark mode for websites.",
  "version": "0.1.0",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sunglasses for Safari",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-dark-mode": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "Turn dark mode on or off"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/base.css"],
      "js": ["content/engine.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
