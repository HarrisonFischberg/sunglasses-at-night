{
  "manifest_version": 3,
  "name": "Sunglasses at Night",
  "description": "Dark mode for websites.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sunglasses at Night"
  },
  "commands": {
    "toggle-dark-mode": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "Turn dark mode on or off"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/engine.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
