{
  "manifest_version": 3,
  "name": "Sunglasses for Safari",
  "description": "Dark mode for websites.",
  "version": "0.1.0",
  "permissions": ["storage", "nativeMessaging", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "action": {
    "default_icon": {
      "16": "images/toolbar-dark-16.png",
      "19": "images/toolbar-dark-19.png",
      "32": "images/toolbar-dark-32.png",
      "38": "images/toolbar-dark-38.png",
      "48": "images/toolbar-dark-48.png",
      "96": "images/toolbar-dark-96.png"
    },
    "default_title": "Sunglasses for Safari",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-dark-mode": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "Turn dark mode on or off"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/base.css"],
      "js": ["content/engine.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
