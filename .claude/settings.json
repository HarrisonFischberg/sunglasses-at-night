{
  "permissions": {
    "allow": [
      "Bash(node --test:*)",
      "Bash(node --check:*)",
      "Bash(node engine/scripts/:*)",
      "Bash(npm run check:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npm run e2e:*)",
      "Bash(npm run perf:*)",
      "Bash(npm run privacy-check:*)",
      "Bash(npm audit:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun simctl:*)",
      "Bash(xcrun safari-web-extension-converter:*)",
      "Bash(python3 ~/.claude/plugins/cache/replica-skill/:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ],
    "defaultMode": "acceptEdits"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "xcodebuild",
      "xcrun"
    ],
    "network": {
      "allowLocalBinding": true
    }
  }
}
