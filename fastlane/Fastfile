opt_out_usage
skip_docs
# Sunglasses at Night: TestFlight and App Store lanes for the iOS and macOS apps
# (one App Store Connect record). Run through ./release.sh; see release/README.md.
# Auth: App Store Connect API key from ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH.
# Listing, age rating, review notes and screenshots: store/ios/.
default_platform(:ios)

ROOT = File.expand_path("..", __dir__)
STORE = "#{ROOT}/store/ios"
VERSION = File.read("#{ROOT}/SunglassesAtNight.xcodeproj/project.pbxproj")[/MARKETING_VERSION = ([\d.]+);/, 1]

platform :ios do
  before_all do |_lane, options|
    next if options[:dry_run]
    app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
                              key_filepath: ENV.fetch("ASC_KEY_PATH"))
  end

  desc "Archive iOS and macOS, upload both to TestFlight, commit the bumped BUILD_NUMBER"
  desc "dry_run:true archives only"
  lane :beta do |options|
    n = File.read("#{ROOT}/BUILD_NUMBER").strip
    sh("#{ROOT}/scripts/archive-testflight.sh", *("--no-upload" if options[:dry_run]))
    next n if options[:dry_run]
    sh("git", "-C", ROOT, "commit", "-m", "Bump BUILD_NUMBER after TestFlight build #{n}", "BUILD_NUMBER")
    n
  end

  desc "beta, then upload metadata, age rating and screenshots and submit both platforms for review"
  desc "dry_run:true archives only and lists what would be uploaded"
  lane :release do |options|
    n = beta(options)
    { "ios" => ["screenshots", n], "osx" => ["screenshots-mac", "20261027.#{n}"] }.each do |platform, (shots, build)|
      if options[:dry_run]
        UI.message("would submit #{platform} #{VERSION} (#{build}) with #{Dir["#{STORE}/#{shots}/*/*.png"].size} screenshots")
        next
      end
      app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
      FastlaneCore::BuildWatcher.wait_for_build_processing_to_be_complete(
        app_id: app.id, platform: platform, app_version: VERSION, build_version: build, poll_interval: 30
      )
      deliver(
        platform: platform,
        app_version: VERSION,
        build_number: build,
        metadata_path: "#{STORE}/metadata",
        screenshots_path: "#{STORE}/#{shots}",
        overwrite_screenshots: true,
        app_rating_config_path: "#{STORE}/age-rating.json",
        submission_information: {
          add_id_info_uses_idfa: false,
          export_compliance_uses_encryption: false,
          content_rights_contains_third_party_content: false
        },
        submit_for_review: true,
        automatic_release: false,
        precheck_include_in_app_purchases: false,
        force: true # no HTML preview prompt
      )
    end
  end
end
